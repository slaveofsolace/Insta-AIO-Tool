{
  "name": "insta-aio-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "description": "Local-first Instagram relationship, queue, and message-data management suite.",
  "author": "slaveofsolace",
  "repository": {
    "type": "git",
    "url": "https://github.com/slaveofsolace/Insta-AIO-Tool.git"
  },
  "bugs": {
    "url": "https://github.com/slaveofsolace/Insta-AIO-Tool/issues"
  },
  "homepage": "https://github.com/slaveofsolace/Insta-AIO-Tool#readme",
  "keywords": [
    "instagram",
    "local-first",
    "pwa",
    "relationship-analysis",
    "data-export"
  ],
  "scripts": {
    "assemble": "node scripts/assemble-app.mjs",
    "build:desktop-assets": "node scripts/build-desktop-assets.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "pack:desktop": "pnpm run assemble && pnpm run build:desktop-assets && electron-builder --dir",
    "dist:win": "pnpm run assemble && pnpm run build:desktop-assets && electron-builder --win nsis",
    "dist:mac": "pnpm run assemble && pnpm run build:desktop-assets && electron-builder --mac dmg zip",
    "benchmark:zip": "node scripts/benchmark-zip-import.mjs",
    "qa:extension": "node scripts/run-extension-acceptance.mjs",
    "qa:chrome": "node scripts/build-extension.mjs && node scripts/chrome-pairing-acceptance.mjs",
    "qa:mac-package": "node scripts/verify-macos-package.mjs",
    "qa:browser:update": "node scripts/assemble-app.mjs && node scripts/run-browser-qa.mjs --update",
    "qa:browser:check": "node scripts/assemble-app.mjs && node scripts/run-browser-qa.mjs --check",
    "qa:overlay:update": "pnpm run build:extension && node scripts/run-overlay-qa.mjs --update",
    "qa:overlay:check": "pnpm run build:extension && node scripts/run-overlay-qa.mjs --check",
    "verify:dependencies": "node scripts/verify-dependencies.mjs",
    "test": "node scripts/verify-dependencies.mjs && node scripts/build-extension.mjs --check && node --test",
    "serve": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "build": {
    "appId": "io.github.slaveofsolace.insta-aio-tool",
    "productName": "Insta AIO Tool",
    "asar": true,
    "files": [
      "desktop/**/*",
      "assets/**/*",
      "src/app-loader.js",
      "src/app.parts/**/*",
      "src/core/**/*",
      "src/adapters/**/*",
      "src/migrations/**/*",
      "src/workers/**/*",
      "src/styles.css",
      "index.html",
      "manifest.webmanifest",
      "sw.js",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "directories": {
      "output": "dist/desktop"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "dist/branding/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "dist/branding/icon.png",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "fake-indexeddb": "6.2.5"
  }
}
