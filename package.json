{
  "name": "insta-toolbox",
  "version": "3.1.7",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "description": "Drop a local toolbox into Instagram—check mutuals, review follow/unfollow targets, and clean up sent DMs with Tampermonkey, Chrome, desktop, or PWA.",
  "author": "slaveofsolace (https://github.com/slaveofsolace)",
  "repository": {
    "type": "git",
    "url": "https://github.com/slaveofsolace/Insta-Toolbox.git"
  },
  "bugs": {
    "url": "https://github.com/slaveofsolace/Insta-Toolbox/issues"
  },
  "homepage": "https://slaveofsolace.github.io/Insta-Toolbox/",
  "keywords": [
    "instagram",
    "tampermonkey",
    "userscript",
    "chrome-extension",
    "local-first",
    "pwa",
    "electron",
    "instagram-tools",
    "privacy",
    "relationship-analysis",
    "data-export"
  ],
  "scripts": {
    "assemble": "node scripts/assemble-app.mjs",
    "build:desktop-assets": "node scripts/build-desktop-assets.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "build:web": "node scripts/build-web-package.mjs",
    "pack:desktop": "pnpm run assemble && pnpm run build:desktop-assets && electron-builder --dir",
    "dist:win": "pnpm run assemble && pnpm run build:desktop-assets && electron-builder --win nsis --publish never",
    "dist:mac": "pnpm run assemble && pnpm run build:desktop-assets && electron-builder --mac dmg zip --universal --publish never",
    "benchmark:zip": "node scripts/benchmark-zip-import.mjs",
    "qa:extension": "node scripts/run-extension-acceptance.mjs",
    "qa:chrome": "node scripts/build-extension.mjs && node scripts/chrome-pairing-acceptance.mjs",
    "qa:mac-package": "node scripts/verify-macos-package.mjs",
    "qa:browser:update": "node scripts/assemble-app.mjs && node scripts/run-browser-qa.mjs --update",
    "qa:browser:check": "node scripts/assemble-app.mjs && node scripts/run-browser-qa.mjs --check",
    "qa:overlay:update": "pnpm run build:extension && node scripts/run-overlay-qa.mjs --update",
    "qa:overlay:check": "pnpm run build:extension && node scripts/run-overlay-qa.mjs --check",
    "release:checksums": "node scripts/generate-release-checksums.mjs",
    "verify:desktop-archive": "node scripts/verify-desktop-archive.mjs",
    "verify:extension-package": "node scripts/verify-extension-package.mjs",
    "verify:web-package": "node scripts/verify-web-package.mjs",
    "verify:dependencies": "node scripts/verify-dependencies.mjs",
    "verify:repo-hygiene": "node scripts/check-repository-hygiene.mjs",
    "test": "node scripts/verify-dependencies.mjs && node scripts/check-repository-hygiene.mjs && node scripts/build-extension.mjs --check && node scripts/build-userscript.mjs --check && pnpm run build:web && pnpm run verify:web-package && node --test",
    "serve": "node scripts/serve.mjs",
    "build:userscript": "node scripts/build-userscript.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "build": {
    "appId": "com.slaveofsolace.instatoolbox",
    "productName": "Insta Toolbox",
    "asar": true,
    "files": [
      "desktop/**/*",
      "assets/**/*",
      "src/app-loader.js",
      "src/app.parts/**/*",
      "src/core/**/*",
      "src/adapters/**/*",
      "src/migrations/**/*",
      "src/workers/**/*",
      "src/styles.css",
      "index.html",
      "manifest.webmanifest",
      "sw.js",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "directories": {
      "output": "dist/desktop"
    },
    "win": {
      "artifactName": "Insta-Toolbox-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "dist/branding/icon.ico"
    },
    "mac": {
      "artifactName": "Insta-Toolbox-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "dist/branding/icon.png",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": true,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist"
    },
    "nsis": {
      "differentialPackage": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "fake-indexeddb": "6.2.5"
  }
}
