  ['settings', 'Settings'],
  ['activity', 'Activity'],
];

function escapeHtml(value) {
  return String(value ?? '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#039;');
}

function formatDate(value, includeTime = true) {
  if (!value) return '—';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '—';
  return includeTime
    ? date.toLocaleString()
    : date.toLocaleDateString();
}

function formatBytes(value) {
  const bytes = Math.max(0, Number(value) || 0);
  if (bytes < 1024) return `${bytes} B`;
  const units = ['KB', 'MB', 'GB'];
  let size = bytes;
  let unit = -1;
  do {
    size /= 1024;
    unit += 1;
  } while (size >= 1024 && unit < units.length - 1);
  return `${size.toFixed(size >= 10 ? 1 : 2)} ${units[unit]}`;
}

function profileUrl(username) {
  return `https://www.instagram.com/${encodeURIComponent(normalizeUsername(username))}/`;
}

function activeSnapshot() {
  return state.snapshots.find((snapshot) => snapshot.id === state.activeSnapshotId)
    || latestSnapshot(state.snapshots);
}

function activeDiff() {
  const current = activeSnapshot();
  return compareSnapshots(previousSnapshot(state.snapshots, current?.id), current);
}

function logActivity(kind, message, details = {}) {
  state.activity.unshift({
    id: `${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
    timestamp: new Date().toISOString(),
    kind,
    message,
    details,
  });
  state.activity = state.activity.slice(0, 5000);
}

function applyAccountBridgeResult(job, result) {
  let next = job;
  for (const record of result?.results || []) {
    const item = next.items.find((candidate) => candidate.id === record.itemId);
    if (!item) continue;
    const completed = record.status === 'resolved-no-click';
    next = appendActionCheckpoint(next, item.id, {
      status: completed ? 'dry-run-complete' : 'safe-stopped',
      result: completed ? 'resolved-no-click' : null,
      beforeEvidence: record.observation?.evidence || null,
      error: completed ? null : result.stopReason || 'bridge-inspection-failed',
    }, {
      activity: {
        id: `${item.id}:extension-dry-run:${Date.now()}`,
        timestamp: new Date().toISOString(),
        kind: completed ? 'action-dry-run' : 'action-safe-stop',
        message: completed
          ? `Resolved ${item.action} for @${item.username} without clicking.`
          : `Extension inspection stopped before ${item.action} for @${item.username}.`,
        details: { stopReason: result.stopReason || null },
      },
    });
  }
  next.status = result?.status === 'dry-run-complete' ? 'completed' : 'stopped';
  next.control = 'stopped';
  next.stopReason = result?.stopReason || null;
  next.updatedAt = new Date().toISOString();
  return next;
}

function applyDmBridgeResult(job, result) {
  let next = job;
  for (const record of result?.results || []) {
    const item = next.items.find((candidate) => candidate.id === record.itemId);
    if (!item) continue;
    next = appendDmCheckpoint(next, item.id, {
      status: record.status === 'resolved-no-click' ? 'dry-run-complete' : 'safe-stopped',
      result: record.status === 'resolved-no-click' ? 'resolved-no-click' : null,
      resolutionEvidence: record.observation?.evidence || null,
      error: record.status === 'resolved-no-click'
        ? null
        : result.stopReason || 'bridge-inspection-failed',
    }, {
      activity: {
        id: `${item.id}:extension-dry-run:${Date.now()}`,
        timestamp: new Date().toISOString(),
        kind: record.status === 'resolved-no-click' ? 'dm-dry-run' : 'dm-safe-stop',
        message: record.status === 'resolved-no-click'
          ? `Resolved sent message ${item.messageId} without clicking Unsend.`
          : `Extension inspection stopped before message ${item.messageId}.`,
        details: { stopReason: result.stopReason || null },
      },
    });
  }
  next.status = result?.status === 'dry-run-complete' ? 'completed' : 'stopped';
  next.control = 'stopped';
  next.stopReason = result?.stopReason || null;
  next.updatedAt = new Date().toISOString();
  return next;
}

async function persist({ rerender = true } = {}) {
  await saveState(state);
  if (rerender) render();
}

function downloadJson(filename, data) {
  const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
  downloadBlob(filename, blob);
}

function downloadText(filename, text, type = 'text/plain') {
  downloadBlob(filename, new Blob([text], { type }));
}

function downloadBlob(filename, blob) {
  const url = URL.createObjectURL(blob);
  const anchor = document.createElement('a');
  anchor.href = url;
  anchor.download = filename;
  document.body.append(anchor);
  anchor.click();
  anchor.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}

function requestExactConfirmation({
  title,
  description,
  phrase,
  destructive = false,
}) {
  let dialog = document.querySelector('#exact-confirmation-dialog');
  if (!dialog) {
    dialog = document.createElement('dialog');
    dialog.id = 'exact-confirmation-dialog';
    dialog.innerHTML = `
      <form method="dialog" class="confirmation-card">
        <h2 data-confirmation-title></h2>
        <p data-confirmation-description></p>
        <div class="notice"><span class="code" data-confirmation-phrase></span></div>
        <div class="field">
          <label for="exact-confirmation-input">Enter the phrase exactly</label>
          <input id="exact-confirmation-input" autocomplete="off" spellcheck="false">
        </div>
        <div class="toolbar confirmation-actions">
          <button value="cancel">Cancel</button>
          <button data-confirmation-submit value="confirm">Confirm</button>
        </div>
      </form>
    `;
    document.body.append(dialog);
  }
  dialog.querySelector('[data-confirmation-title]').textContent = title;
  dialog.querySelector('[data-confirmation-description]').textContent = description;
  dialog.querySelector('[data-confirmation-phrase]').textContent = phrase;
  const input = dialog.querySelector('#exact-confirmation-input');
  const submit = dialog.querySelector('[data-confirmation-submit]');
  input.value = '';
  dialog.returnValue = 'cancel';
  submit.className = destructive ? 'danger' : 'primary';

  return new Promise((resolve) => {
    const onClose = () => {
      dialog.removeEventListener('close', onClose);
      resolve(dialog.returnValue === 'confirm' ? input.value : null);
    };
    dialog.addEventListener('close', onClose);
    dialog.showModal();
    input.focus();
  });
}

function csvEscape(value) {
  const text = String(value ?? '');
  return /[",\n]/.test(text) ? `"${text.replaceAll('"', '""')}"` : text;
}

function accountsToCsv(accounts) {
  const rows = [['username', 'id', 'displayName', 'profileUrl', 'source']];
  for (const account of accounts || []) {
    rows.push([
      account.username,
      account.id || '',
      account.displayName || '',
      account.profileUrl || profileUrl(account.username),
      account.source || '',
    ]);
  }
  return rows.map((row) => row.map(csvEscape).join(',')).join('\n');
}

function pageHead(title, description, actions = '') {
  return `
    <header class="page-head">
      <div>
        <h1 data-page-heading tabindex="-1">${escapeHtml(title)}</h1>
        <p>${escapeHtml(description)}</p>
      </div>
      ${actions ? `<div class="toolbar">${actions}</div>` : ''}
    </header>
  `;
}

function metric(label, value, detail = '') {
  return `
    <article class="metric">
      <div class="label">${escapeHtml(label)}</div>
      <div class="value">${escapeHtml(value)}</div>
      ${detail ? `<div class="detail">${escapeHtml(detail)}</div>` : ''}
    </article>
  `;
}

function renderShell(content) {
  return `
    <div class="app-shell">
      <aside class="sidebar">
        <div class="brand">
          <div class="brand-mark">IA</div>
          <div class="brand-copy"><strong>Insta AIO Tool</strong><span>Local-first workspace</span></div>
        </div>
        <nav class="nav" aria-label="Primary navigation">
          ${views.map(([id, label]) => `
            <button type="button" data-action="navigate" data-view="${id}" class="${activeView === id ? 'active' : ''}">${escapeHtml(label)}</button>
          `).join('')}
        </nav>
        <div class="sidebar-foot">
          Data remains in this browser unless you export it.<br>
          Live actions stay locked until one exact reviewed item is armed on Instagram.
        </div>
      </aside>
      <main class="main">${content}</main>
      <input id="data-file-input" class="hidden" type="file" accept=".json,application/json" multiple>
      <input id="data-folder-input" class="hidden" type="file" accept=".json,application/json" multiple webkitdirectory>
      <input id="zip-file-input" class="hidden" type="file" accept=".zip,application/zip">
      <input id="state-file-input" class="hidden" type="file" accept=".json,application/json">
    </div>
  `;
}

function renderOverview() {
  const snapshot = activeSnapshot();
  const relationships = classifyRelationships(snapshot || { followers: [], following: [] });
  const diff = activeDiff();
  const queue = getQueueSummary(state.queue);
  const sentMessages = state.messages.filter((message) => message.isMine).length;

  return pageHead(
    'Overview',
    'Relationship history, scheduled reviews, and message-data planning in one local workspace.',
    '<button class="primary" data-action="pick-data-files">Import Instagram data</button>',
  ) + `
    <section class="grid metrics">
      ${metric('Followers', snapshot?.followers.length || 0, snapshot ? `Snapshot ${formatDate(snapshot.capturedAt, false)}` : 'No snapshot imported')}
      ${metric('Following', snapshot?.following.length || 0, `${relationships.mutuals.length} mutual`)}
      ${metric('Not following back', relationships.notFollowingBack.length, `${diff.lostFollowers.length} newly lost since prior snapshot`)}
      ${metric('Queue ready', queue.ready || 0, `${queue.waiting || 0} waiting`)}
      ${metric('New followers', diff.newFollowers.length, 'Compared with prior snapshot')}
      ${metric('Recent unfollows', diff.lostFollowers.length, 'Detected by snapshot comparison')}
      ${metric('Messages loaded', state.messages.length, `${sentMessages} identified as sent by you`)}
      ${metric('Unsend selected', state.selectedMessageIds.length, 'Reviewed preview or one-message gate')}
    </section>

    <section class="panel">
      <div class="panel-head">
        <div><h2>Current status</h2><p>Local analysis, reviewed jobs, and delivery safeguards.</p></div>
      </div>
      <div class="notice">
        Imports, relationship history, queue protection, message review, no-click dry runs, extension pairing, and local exports are available. Live actions stay locked by default. A paired, fresh, one-item Follow, Unfollow, or sent-message Unsend job may use the controlled Instagram arm-and-return gate.
      </div>
      <div class="kpi-row" style="margin-top:14px">
        <span><strong>${state.snapshots.length}</strong> snapshots</span>
        <span><strong>${state.queue.length}</strong> queue records</span>
        <span><strong>${conversationSummary(state.messages).length}</strong> conversations</span>
        <span><strong>${state.activity.length}</strong> activity records</span>
      </div>
    </section>
