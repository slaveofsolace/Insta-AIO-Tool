function assertCurrentActionExecution(controller, job) {
  const current = state.actionJobs?.[0];
  if (
    actionExecutionController !== controller
    || actionExecutionJobId !== job.id
    || controller.signal.aborted
    || current?.id !== job.id
    || current?.previewDigest !== job.previewDigest
    || current?.mode !== job.mode
    || current?.confirmedAt !== job.confirmedAt
    || !['ready', 'running', 'paused', 'stopped', 'completed'].includes(current?.status)
  ) {
    throw new Error('The reviewed action job was discarded or changed; execution canceled.');
  }
  return current;
}

function assertCurrentDmExecution(controller, job) {
  const current = state.dmJobs?.[0];
  if (
    dmExecutionController !== controller
    || dmExecutionJobId !== job.id
    || controller.signal.aborted
    || current?.id !== job.id
    || current?.previewDigest !== job.previewDigest
    || current?.mode !== job.mode
    || current?.reviewConfirmedAt !== job.reviewConfirmedAt
    || current?.destructiveConfirmedAt !== job.destructiveConfirmedAt
    || !['ready', 'running', 'paused', 'stopped', 'completed'].includes(current?.status)
  ) {
    throw new Error('The reviewed DM job was discarded or changed; execution canceled.');
  }
  return current;
}

const views = [
  ['overview', 'Overview'],
  ['relationships', 'Relationships'],
  ['queue', 'Action Queue'],
  ['messages', 'Messages'],
