{
  "manifest_version": 3,
  "name": "Insta AIO Companion",
  "version": "0.8.1",
  "description": "Movable local-first Instagram toolbox for follower checks, no-click account review, and exact-message evidence.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Insta AIO Companion",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "action-labels.js",
        "content-instagram.js",
        "overlay/shared.js",
        "overlay/preferences.js",
        "overlay/route-observer.js",
        "overlay/theme.js",
        "overlay/bridge.js",
        "overlay/downloads.js",
        "overlay/accessibility.js",
        "overlay/layout.js",
        "overlay/collision.js",
        "overlay/icons.js",
        "overlay/batch.js",
        "overlay/shell.js",
        "overlay/views/now.js",
        "overlay/views/capture.js",
        "overlay/views/queue.js",
        "overlay/views/messages.js",
        "overlay/views/workspace.js",
        "instagram-overlay.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
