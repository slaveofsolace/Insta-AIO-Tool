{
  "manifest_version": 3,
  "name": "Insta AIO Companion",
  "version": "0.2.0",
  "description": "Local-first Instagram sidecar for visible capture, manual queues, and reviewed no-click inspection.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Insta AIO Companion",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "content-instagram.js",
        "instagram-overlay.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
